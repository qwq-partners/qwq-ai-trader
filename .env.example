# QWQ AI Trader 로컬 개발용 예제
#
# 이 파일에는 실제 값을 넣지 마세요. 필요한 항목만 `.env`에 복사하고
# `.env`는 절대 커밋하지 마세요. 이 템플릿은 주문 실행을 허가하지 않습니다.

# KIS — 로컬에서는 개발 환경만 사용
KIS_ENV=dev
KIS_APPKEY=
KIS_APPSECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=
KIS_EXT_ACCOUNTS=

# LLM
OPENAI_API_KEY=
GEMINI_API_KEY=
MANUS_API_KEY=
PERPLEXITY_API_KEY=

# 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 선택 설정
INITIAL_CAPITAL=500000

# Toss 관측 — 기본 OFF. 1만으로 활성화되지 않으며 승인 registry/plan/launcher가 필요합니다.
# 주문·청산·사이징에는 사용하지 않습니다. 실제 자격은 이 파일에 넣지 마세요.
TOSS_API=0
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
