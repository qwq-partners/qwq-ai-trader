# QWQ AI Trader 로컬 개발용 예제
#
# 이 파일에는 실제 값을 넣지 마세요. 필요한 항목만 `.env`에 복사하고
# `.env`는 절대 커밋하지 마세요. 이 템플릿은 주문 실행을 허가하지 않습니다.

# KIS — 로컬에서는 개발 환경만 사용
KIS_ENV=dev
KIS_APPKEY=
KIS_APPSECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=
KIS_EXT_ACCOUNTS=

# LLM
OPENAI_API_KEY=
GEMINI_API_KEY=
MANUS_API_KEY=
PERPLEXITY_API_KEY=

# 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 선택 설정
INITIAL_CAPITAL=500000

# 토스증권 Open API (2026-09-16 T12 Phase 1 — 읽기 전용 2차 시세 소스, 대조 기록만)
TOSS_API=1
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
