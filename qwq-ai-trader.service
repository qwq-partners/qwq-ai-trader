# 운영 설치본(/etc/systemd/system/qwq-ai-trader.service)의 사본 — 2026-09-30 동기화(OOMScoreAdjust 추가). 설치본이 정본이다.
[Unit]
Description=QWQ AI Trader
After=network-online.target postgresql.service cloudflared.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/qwq-ai-trader
EnvironmentFile=/home/ubuntu/projects/qwq-ai-trader/.env
ExecStart=/home/ubuntu/projects/qwq-ai-trader/venv/bin/python scripts/run_trader.py --market kr --config /home/ubuntu/projects/qwq-ai-trader/config/default.yml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
# 호스트 메모리 부족 시 봇보다 다른 프로세스를 먼저 죽인다 (2026-09-30, 09-29 22:21 OOM kill 재발 방지)
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
